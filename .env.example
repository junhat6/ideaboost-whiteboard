# Copy to .dev.vars locally. Never commit actual values or private keys.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
ALLOWED_EMAILS=approved-member@example.com
APP_ORIGIN=https://your-approved-hostname
GITHUB_APP_ID=5473658
GITHUB_INSTALLATION_ID=175301060
GITHUB_APP_PRIVATE_KEY=

# Explicit temporary anonymous read/write mode; the path is not authentication.
# AUTH_MODE=public-temporary
# PUBLIC_PATH=/b/<48 lowercase hex characters from a cryptographic random generator>

# PBI Story pointsの後読込。実Appの定義/値read確認後にのみ有効化する。
# 確定field: 49067031 / number / visibility=all。権限拡張は別途承認が必要。
STORY_POINTS_READ_ENABLED=false
