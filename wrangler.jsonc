{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideaboost-whiteboard",
  "main": "worker/entry.ts",
  "durable_objects": {
    "bindings": [
      { "name": "MUTATIONS", "class_name": "IssueCoordinator" },
      { "name": "HISTORY", "class_name": "HistoryCoordinator" },
      { "name": "TEAM_NOTES", "class_name": "TeamNotesCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IssueCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["HistoryCoordinator"] },
    { "tag": "v3", "new_sqlite_classes": ["TeamNotesCoordinator"] },
  ],
  "compatibility_date": "2026-10-26",
  "ratelimits": [
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "5473658",
      "simple": { "limit": 30, "period": 60 },
    },
    // MCP 経由の書き込みの、利用者ごとの上限（ADR 018）。dev と同じ 20 回 / 60 秒から始める。
    // namespace_id はアカウント内のほかの rate limit（PUBLIC_LIMITER・dev の MCP_LIMITER）と重ならない値。
    {
      "name": "MCP_LIMITER",
      "namespace_id": "8160001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "GITHUB_APP_ID": "5473658",
    "GITHUB_INSTALLATION_ID": "175301060",
    // チームの付箋は本番で有効（2026-11-25 オーナー方針、ADR 016）。public-temporary の間は
    // 実 Issue の編集と同じく、秘密の path・Origin・共有の rate limit の内側で匿名で書ける。
    "TEAM_NOTES_ENABLED": "true",
    // リモート MCP（/mcp）もフラグは有効。ただし Worker は public-temporary では常に 404 を返す（匿名の MCP は作らない）。
    // ログイン必須化（AUTH_MODE を外す）と同時に、Access の JWT で認証されたメンバーにだけ開く（ADR 018）。
    "TEAM_NOTES_MCP_ENABLED": "true",
  },
  // 付箋とリモート MCP を実際の AI クライアントで試す dev（ADR 017）。CI・release は deploy しない。
  // 人が `wrangler deploy --env dev` するときだけ使う。本番の値・URL・secret はここへ写さない。
  "env": {
    "dev": {
      // 別の Worker 名 → Durable Object の namespace も本番と別になる。
      "name": "ideaboost-whiteboard-dev",
      // durable_objects と vars は env へ継承されないため、ここで全部を書き直す。
      "durable_objects": {
        "bindings": [
          { "name": "MUTATIONS", "class_name": "IssueCoordinator" },
          { "name": "HISTORY", "class_name": "HistoryCoordinator" },
          { "name": "TEAM_NOTES", "class_name": "TeamNotesCoordinator" },
        ],
      },
      // ratelimits の PUBLIC_LIMITER は置かない。dev は public-temporary を使わず、
      // 誤って AUTH_MODE=public-temporary にしても API は 503 で閉じる。
      // MCP_LIMITER は MCP 経由の書き込みの、利用者ごとの上限（ADR 016 の M2）。本番には置かない。
      "ratelimits": [
        {
          "name": "MCP_LIMITER",
          "namespace_id": "8160002",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "TEAM_NOTES_ENABLED": "true",
        "TEAM_NOTES_MCP_ENABLED": "true",
        // 実チームの Issue へ書かない。GitHub App の ID・鍵も置かないので読み取りもしない。
        "GITHUB_WRITES": "disabled",
      },
    },
  },
}
