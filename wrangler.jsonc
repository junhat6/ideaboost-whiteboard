{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideaboost-whiteboard",
  "main": "worker/entry.ts",
  "durable_objects": {
    "bindings": [{ "name": "MUTATIONS", "class_name": "IssueCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IssueCoordinator"] }],
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GITHUB_APP_ID": "5473658", "GITHUB_INSTALLATION_ID": "175301060" },
}
