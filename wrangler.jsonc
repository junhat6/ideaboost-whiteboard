{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideaboost-whiteboard",
  "main": "worker/entry.ts",
  "durable_objects": {
    "bindings": [
      { "name": "MUTATIONS", "class_name": "IssueCoordinator" },
      { "name": "HISTORY", "class_name": "HistoryCoordinator" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IssueCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["HistoryCoordinator"] },
  ],
  "compatibility_date": "2026-10-26",
  "ratelimits": [
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "5473658",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GITHUB_APP_ID": "5473658", "GITHUB_INSTALLATION_ID": "175301060" },
}
