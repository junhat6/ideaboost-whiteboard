{
  "name": "ideaboost-whiteboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build:editor && WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "lint": "eslint editor worker web server scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "design:lint": "designmd lint DESIGN.md",
    "deploy": "wrangler deploy",
    "build:editor": "node scripts/build-icons.mjs && esbuild editor/index.js --bundle --format=esm --minify --outfile=web/editor-bundle.js --legal-comments=inline && esbuild editor/diagram-worker.js --bundle --format=esm --minify --outfile=web/diagram-worker.js --legal-comments=inline",
    "pretest:e2e": "npm run build:editor",
    "predev": "npm run build:editor",
    "predeploy": "npm run build:editor"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "dompurify": "^3.4.17",
    "jose": "^6.1.0",
    "marked": "^18.1.1",
    "parse5": "8.0.1",
    "pele": "1.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.39.0",
    "@google/design.md": "*",
    "@playwright/test": "^1.56.0",
    "@primer/octicons": "19.42.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  }
}
